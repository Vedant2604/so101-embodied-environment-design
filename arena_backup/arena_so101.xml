<mujoco model="so101 two-zone arena">
  <include file="so_arm100.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="tray" pos="0 -0.30 0">
      <geom name="tray_floor" type="box" size="0.125 0.05 0.005" pos="0 0 0.005"
            rgba="0.92 0.92 0.88 1" friction="0.5 0.005 0.0001"/>
      <geom name="wall_left"  type="box" size="0.005 0.05 0.0175" pos="-0.13 0 0.0275" rgba="0.6 0.6 0.6 1"/>
      <geom name="wall_right" type="box" size="0.005 0.05 0.0175" pos="0.13 0 0.0275"  rgba="0.6 0.6 0.6 1"/>
      <geom name="wall_far"   type="box" size="0.135 0.005 0.0175" pos="0 -0.055 0.0275" rgba="0.6 0.6 0.6 1"/>
      <geom name="wall_near"  type="box" size="0.135 0.005 0.0175" pos="0 0.055 0.0275"  rgba="0.6 0.6 0.6 1"/>

      <geom name="zone_A" type="cylinder" size="0.04 0.0005" pos="-0.075 0 0.0105"
            rgba="0.2 0.55 1.0 0.5" contype="0" conaffinity="0"/>
      <geom name="zone_B" type="cylinder" size="0.04 0.0005" pos="0.075 0 0.0105"
            rgba="1.0 0.55 0.2 0.5" contype="0" conaffinity="0"/>
    </body>

    <body name="cube" pos="-0.075 -0.30 0.03">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.0125 0.0125 0.0125"
            rgba="0.9 0.1 0.1 1" mass="0.03" friction="0.6 0.005 0.0001"/>
    </body>

    <camera name="top_view" pos="0 -0.30 0.55" euler="0 0 0" fovy="55"/>
  </worldbody>
</mujoco>